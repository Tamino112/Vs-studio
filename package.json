{
  "name": "vs-studio-community-macos",
  "version": "1.0.0",
  "description": "Visual Studio Community (Windows & macOS) — C# & .NET 10 IDE",
  "main": "dist-electron/main.js",
  "author": "Tamino112",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && tsc -p tsconfig.main.json && electron .\"",
    "dev:vite": "vite",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.main.json",
    "build": "npm run build:renderer && npm run build:electron",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit",
    "test": "vitest run",
    "package:win": "npm run build && electron-builder --win --publish never",
    "package:win:dir": "npm run build && electron-builder --win dir --publish never",
    "package:win:portable": "npm run build && electron-builder --win portable --publish never",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "package:mac:dir": "npm run build && electron-builder --mac dir --publish never"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.36",
    "fast-xml-parser": "^4.5.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8",
    "wait-on": "^8.0.2"
  }
}
